# Local app runtime.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional local canonical URL for metadata, robots, and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Convex development deployment, written by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Convex actions. Set these in Convex hosted env vars for production.
OPENAI_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
