{
  "name": "menu-garden",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --only --filter=@menu-garden/web --filter=@menu-garden/mobile",
    "convex:dev": "npm run convex:dev --workspace @menu-garden/shared",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "turbo": "2.6.2"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@1.22.22"
}
