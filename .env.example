# Local web app runtime.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Convex development deployment, written by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Vercel build-time Convex deployment.
# Set this in Vercel, not in committed files.
CONVEX_DEPLOY_KEY=

# Convex hosted env vars.
CLERK_JWT_ISSUER_DOMAIN=
OPENAI_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
